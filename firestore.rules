rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['OWNER', 'SUPER_ADMIN', 'ADMIN']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    // Public portal settings: visitors can read; only admins can change.
    match /siteSettings/{settingId} {
      allow read: if settingId == 'public';
      allow create, update, delete: if isAdmin();
    }

    // Public content is readable by everyone. Only admins can manage it.
    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['announcements', 'news', 'events'];
      allow create, update, delete: if isAdmin() && collectionName in ['announcements', 'news', 'events'];
    }

    // Admin profile lookup. Users can read their own user document; admins can read users.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
  }
}